<Window x:Class="SongInfoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SongInfoViewer"
        mc:Ignorable="d"
        Title="Song Info Viewer" Height="600" Width="1000"
        MinHeight="400" MinWidth="700"
        Background="#121212"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- アルバムアート領域 -->
        <Border Grid.Column="0" 
                Width="320" Height="320" 
                CornerRadius="16" 
                Background="#2A2A2A" 
                ClipToBounds="True"
                VerticalAlignment="Center">
            <Grid>
                <!-- アルバムアート画像（データ設定時に表示） -->
                <Image Source="{Binding AlbumArt}" 
                       Stretch="UniformToFill" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                
                <!-- 画像が無い場合のプレースホルダーアイコン/背景 -->
                <Grid Visibility="{Binding AlbumArt, Converter={x:Static local:NullToVisibilityConverter.Instance}, FallbackValue=Visible}">
                    <Border Background="#282828"/>
                    <TextBlock Text="🎵" 
                               FontSize="96" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Foreground="#555555"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 楽曲情報テキスト領域 -->
        <StackPanel Grid.Column="1" 
                    Margin="40,0,0,0" 
                    VerticalAlignment="Center">
            
            <!-- 曲名 -->
            <TextBlock Text="{Binding SongTitle, FallbackValue='曲名サンプル'}" 
                       FontSize="40" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,16"/>

            <!-- アーティスト名 -->
            <TextBlock Text="{Binding ArtistName, FallbackValue='アーティストサンプル'}" 
                       FontSize="26" 
                       FontWeight="SemiBold" 
                       Foreground="#E0E0E0" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,12"/>

            <!-- アルバム名 -->
            <TextBlock Text="{Binding AlbumTitle, FallbackValue='アルバムサンプル'}" 
                       FontSize="20" 
                       Foreground="#A0A0A0" 
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
